# DO NOT COMMIT THIS FILE OR .env.local TO GIT
# Copy this file to .env.local and fill in actual values
# .env.local is in .gitignore and will never be committed

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Membership
EXPO_PUBLIC_MEMBERSHIP_AMOUNT=1500
EXPO_PUBLIC_MEMBERSHIP_CURRENCY=INR

# Supabase Edge Function secrets (set via Supabase Dashboard)
# NEVER store service role key in client .env - only on server
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret-key
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email Service API Keys (optional - for sendgrid/resend/mailgun)
# RESEND_API_KEY=your-resend-key
# SENDGRID_API_KEY=your-sendgrid-key
# MAILGUN_API_KEY=your-mailgun-key
