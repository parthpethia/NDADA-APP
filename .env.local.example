# DO NOT COMMIT THIS FILE OR .env.local TO GIT
# Copy this file to .env.local and fill in actual values
# .env.local is in .gitignore and will never be committed

# Supabase (public keys - safe to commit in local environment)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Membership
EXPO_PUBLIC_MEMBERSHIP_AMOUNT=300
EXPO_PUBLIC_MEMBERSHIP_CURRENCY=INR

# Razorpay public key for frontend (Standard Checkout modal)
# This is KEY_ID only — safe to expose to the client
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Resend API Key for Email Service
RESEND_API_KEY=re_xxxxx
EXPO_PUBLIC_RESEND_API_KEY=re_xxxxx


# ⚠️ SERVER-SIDE SECRETS WARNING:
# Do not store SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, or
# RAZORPAY_WEBHOOK_SECRET in your local .env or .env.local files.
# These server-side secrets must be configured in your Supabase Dashboard
# under Project Settings -> API (for service role) and Database -> Edge Functions
# (for Razorpay keys).
# Refer to docs/SECRETS_MIGRATION.md for details.
