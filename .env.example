# DO NOT COMMIT ACTUAL SECRETS TO THIS FILE
# For local development, copy to .env.local and add real values
# .env.local is in .gitignore and will never be committed

# Supabase (public keys - safe to commit)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# App
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Membership
EXPO_PUBLIC_MEMBERSHIP_AMOUNT=1500
EXPO_PUBLIC_MEMBERSHIP_CURRENCY=INR

# Razorpay public key for frontend (Standard Checkout modal)
# This is KEY_ID only — safe to expose to the client
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ⚠️ SECRET KEYS - NEVER COMMIT REAL VALUES TO .env.example
# Set these in .env.local (git-ignored) or Supabase Dashboard
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your-secret-key
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
